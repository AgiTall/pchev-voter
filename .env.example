# Токен бота из Discord Developer Portal
DISCORD_TOKEN=your_bot_token

# Application ID бота
CLIENT_ID=your_application_id

# Необязательно. Раскомментируйте и укажите числовой ID тестового сервера.
# Без GUILD_ID команда будет зарегистрирована глобально и может появиться не сразу.
# GUILD_ID=

# Необязательно. Локально для votes.json и politics.json используется папка data.
# На Render это значение уже задаётся через render.yaml.
# VOTE_DATA_DIR=

# Необязательно. Путь к резервному votes.json, из которого будут добавлены
# отсутствующие голосования. Существующие записи не перезаписываются.
# VOTE_SEED_FILE=

# PostgreSQL. Если DATABASE_URL задан, votes.json и politics.json используются
# только для импорта, а все новые изменения сохраняются в базе данных.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Необязательно. Резервная копия politics.json для первичного импорта в БД.
# POLITICS_SEED_FILE=
